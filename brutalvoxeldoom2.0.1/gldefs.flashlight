// Flashlight point lights, ported from brutal22test6 (Sergeant_Mark_IV's Brutal Doom
// v22, gldefs.flashlight). Referenced by name from actors/flashlight_gz.dec's
// Light() calls. Trimmed to the ten PointLights actually used; the original file's
// FlashlightPuff/FlashlightBeam object+pointlight blocks belonged to a hitscan-puff
// based flashlight variant that was not ported (see zscript/BD_Flashlight.zc).
// Warm/Red variants (cl_bd_flashlightcolor) are new, not in the original.

PointLight FlashlightLight1
{
	Color 1.0 1.0 1.0
	Size 20
}

PointLight FlashlightLight2
{
	Color 0.2 0.2 0.2
	Size 24
}

PointLight FlashlightLight3
{
	Color 0.6 0.6 0.6
	Size 28
}

PointLight FlashlightLight4
{
	Color 0.3 0.3 0.35
	Size 32
}

PointLight FlashlightLight5
{
	Color 0.25 0.25 0.3
	Size 36
}

PointLight FlashlightLight6
{
	Color 1.0 1.0 1.0
	Size 40
}

PointLight FlashlightLight7
{
	Color 0.2 0.2 0.23
	Size 44
}

PointLight FlashlightLight8
{
	Color 0.2 0.2 0.23
	Size 48
