//===========================================================================
//
// Boss health display, adapted from brutal22test6 (Sergeant_Mark_IV's Brutal
// Doom v22, src/BOSSHEALTH.acs).
//
// The original is triggered by the boss monster itself calling
// ACS_ExecuteAlways(621) from its own state, which would mean editing every
// boss actor in this pack's actors/monsters.txt. Instead this watches for
// any living, alerted actor flagged +BOSS near the player — Cyberdemon and
// SpiderMastermind both are by default in UZDoom/GZDoom's own DECORATE, and
// so is anything derived from them (which is how this pack replaces them),
// so no monster definition needs to change at all.
//
//===========================================================================

class BDBossHealthHandler : EventHandler
{
	Actor tracked;
	int trackedHealth;
	int trackedMaxHealth;
	String trackedName;

	const BD_BOSSHEALTH_RANGE = 2048.0;

	override void WorldTick()
	{
		if (consoleplayer < 0 || !playeringame[consoleplayer])
			return;

		PlayerPawn viewer = players[consoleplayer].mo;
		if (!viewer || !CVar.GetCVar("bd_bosshealthbar", players[consoleplayer]).GetBool())
		{
			tracked = null;
			return;
		}

		// keep tracking the same boss as long as it's alive and in range, so the
		// display doesn't flicker between candidates if more than one is near
		if (tracked && (tracked.health <= 0 || tracked.Distance3D(viewer) > BD_BOSSHEALTH_RANGE))
			tracked = null;

		if (!tracked)
		{
			double best = BD_BOSSHEALTH_RANGE;
			ThinkerIterator it = ThinkerIterator.Create("Actor");
			Actor mo;
			while (mo = Actor(it.Next()))
			{
				if (!mo.bBoss || mo.health <= 0 || !mo.target)
					continue;

				double dist = mo.Distance3D(viewer);
				if (dist < best)
				{
					best = dist;
					tracked = mo;
				}
			}
		}

		if (tracked)
		{
			trackedHealth = max(0, tracked.health);
			trackedMaxHealth = max(1, tracked.SpawnHealth());
			trackedName = tracked.GetTag();
		}
	}

	override void RenderOverlay(RenderEvent e)
	{
		if (!tracked)
			return;

		Font big = Font.FindFont('BigFont');
		Font small = Font.FindFont('SmallFont');
		if (!big || !small)
			return;

		int w = Screen.GetWidth();
		String title = "-= " .. trackedName .. " =-";
		String hp = String.Format("%d / %d", trackedHealth, trackedMaxHealth);

		Screen.DrawText(big, Font.CR_RED, (w - big.StringWidth(title)) / 2, 8, title);
		Screen.DrawText(small, Font.CR_WHITE, (w - small.StringWidth(hp)) / 2, 28, hp);
	}
}
