// Small additive glow shown in front of the player while the flashlight is on
// (cl_bd_flashlightsource), ported from brutal22test6's FlashlightSource. Uses the
// "PLFL" sprite (sprites/PLFLA*.png, copied unchanged from brutal22test6).
Actor BDFlashlightSourceGlow
{
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOCLIP
	RenderStyle "Add"
	Alpha 0.9
	XScale 0.5
	YScale 0.3
	States
	{
	Spawn:
		PLFL A 2 NoDelay
		Stop
	}
}
