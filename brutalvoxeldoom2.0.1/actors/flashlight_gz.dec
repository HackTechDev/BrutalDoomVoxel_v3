// Flashlight beam light actors, ported from brutal22test6 (Sergeant_Mark_IV's Brutal
// Doom v22, actors/flashlight_gz.dec). Cosmetic, self-removing point-light markers;
// zscript/BD_Flashlight.zc spawns a short-lived chain of these along the player's
// aim direction each tic. The ten tiers vary only by which GLDEFS PointLight
// (gldefs.flashlight) they trigger, brighter/bigger towards tier 10. Three colour
// palettes (White/Warm/Red, cl_bd_flashlightcolor) are added on top of the original,
// which only had the white set.

Actor FlashLightLight_GZ1
{
	+CLIENTSIDEONLY
	+NOINTERACTION

	States
	{
		Spawn:
			TNT1 A 2 NoDelay Light("FlashlightLight1")
			Stop
	}
}

Actor FlashLightLight_GZ2 : FlashLightLight_GZ1
{
	States
	{
		Spawn:
			TNT1 A 2 NoDelay Light("FlashlightLight2")
			Stop
	}
}

Actor FlashLightLight_GZ3 : FlashLightLight_GZ1
{
	States
	{
		Spawn:
			TNT1 A 2 NoDelay Light("FlashlightLight3")
			Stop
