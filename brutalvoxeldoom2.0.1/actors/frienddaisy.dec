// Second companion animal, adapted from brutal22test6 (Sergeant_Mark_IV's Brutal Doom
// v22, actors/Daisy.dec, sprites by the Skulltag Team). Same shape as
// actors/frienddog.dec (same author, near-identical original file) and the same
// simplifications: player-deployable (zscript/BD_Daisy.zc) instead of a map
// decoration a level designer places and switches on, so the "_Guarding" variant and
// its Activation/+USESPECIAL wiring are dropped, along with the
// retreat-from-tough-monsters AI and the floating order text. Reuses the
// TargetIsAMarine/IsPlayer marker tokens already defined in actors/sentrybot.dec.

Actor FriendDaisy : SwitchableDecoration
{
	Scale 0.8
	Health 80
	Radius 16
	Height 16
	Mass 400
	MaxTargetRange 1000
	Speed 4
	FastSpeed 20
	PainChance 250
	Species "Marines"
	MONSTER
	+QUICKTORETALIATE
	+LOOKALLAROUND
	+PUSHABLE
	+SLIDESONWALLS
	+FLOORCLIP
	-FASTER
	+MTHRUSPECIES
	+THRUSPECIES
	+DONTHURTSPECIES
	+NOBLOCKMONST
	-COUNTKILL
	+THRUACTORS
	DamageType "Eat"
	Damage 6
	MaxStepHeight 48
	MaxDropOffHeight 48
	MeleeDamage 4
	States
	{
	Spawn:
		DASY A 1
		TNT1 A 0 A_GiveInventory("TargetIsAMarine") // stops it attacking sentries/other companions
		DASY A 1 A_Look
		Loop

	ForgetTarget:
		TNT1 A 0 A_ClearTarget
		Goto See

	Idle:
	See:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_Recoil(-1)
		DASY AA 1 A_Chase
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		DASY BB 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		DASY CC 1 A_Chase
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		DASY DD 1 A_Chase
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		DASY AA 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		Goto See

	FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		DASY A 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		DASY AA 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		DASY BB 1 A_Chase
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_Recoil(-1)
		DASY CC 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		DASY DD 1 A_Chase
		Goto CheckIfPlayerSee

	CheckIfPlayerSee:
		TNT1 A 0
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "Pathfind")
		Goto See

	Pathfind:
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		DASY AA 1 A_Chase
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer

	Waits:
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1)
		DASY A 0 A_Look
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		DASY A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1)
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPlayer

	Missile:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer") // never remove this one
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "Waits")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1)
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(200, "ActualFireState")
		TNT1 A 0 A_FaceTarget
		DASY A 1 A_Recoil(-1)
		DASY AABBCCDD 1 A_Chase
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "Waits")
		Goto See

	ActualFireState:
		DASY B 3 A_FaceTarget
		TNT1 A 0 A_Recoil(-6)
		TNT1 A 0 ThrustThingZ(0, 35, 0, 1)
		TNT1 A 0 A_PlaySound("DASYBIT", 3)
		DASY CCDD 3 A_MeleeAttack
		Goto See

	Pain:
		DASY A 2
		DASY A 2 A_Pain
		Goto See+1

	Death:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("misc/xdeath", 3)
		DASY I 4 A_NoBlocking
		DASY JKLM 4
		DASY M -1
		Stop
	}
}
