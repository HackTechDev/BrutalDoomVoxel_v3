// Sentry bot, adapted from brutal22test6 (Sergeant_Mark_IV's Brutal Doom v22,
// actors/SentryBot.dec, sprites by Logan_MTM). There it's a map decoration a level
// designer places and switches on; here zscript/BD_Sentrybot.zc lets the player
// deploy one directly (see BDEXTRASMNU / bd_sentrymax), so the "Sentrybot_Guarding"
// idle-at-spawn-point variant and its Activation/+USESPECIAL wiring aren't needed
// and were dropped, along with:
//   - the retreat-from-tough-monster AI (needed four more marker tokens plus the
//     code elsewhere in brutal22test6 that tags Cyberdemon/Mastermind/Baron/
//     Mancubus with them, none of which exists in this pack);
//   - shell casing spawns and the floating "-Stay-" order text on each shot
//     (cosmetic only);
//   - MarineTracer, its bullet decal and hit-puff (actors/Weapons/Tracers.dec):
//     replaced with BDSentryTracer below, a trimmed copy with no such dependencies,
//     using the same TRAC sprite.
// Kept: the walk/chase/attack/pain/death states and the FRIENDLY-flag juggling that
// makes it fight monsters but never the player or itself.

// ---------------------------------------------------------------------------
// Marker tokens (trimmed copies of brutal22test6's bd_Token/TargetIsAMarine/
// IsPlayer from actors/Tokens.dec, not the other ~700 unrelated tokens in it).
// ---------------------------------------------------------------------------

Actor BDSentryToken : Inventory
{
	Inventory.MaxAmount 1
	+INVENTORY.UNDROPPABLE
	-INVENTORY.INVBAR
	+NONETID
	+INVISIBLE
	+NOCLIP
	+NOTARGET
	+NOBLOCKMAP
	+NOINTERACTION
}

Actor TargetIsAMarine : BDSentryToken {}
Actor IsPlayer : BDSentryToken {}

// ---------------------------------------------------------------------------
// Tracer bullet (trimmed MarineTracer)
// ---------------------------------------------------------------------------

Actor BDSentryTracer : FastProjectile
{
	Projectile
	+RANDOMIZE
	+FORCEXYBILLBOARD
	+DONTSPLASH
	+NOEXTREMEDEATH
	+THRUGHOST
	+THRUSPECIES
	+MTHRUSPECIES
	Radius 2
	Height 2
	Speed 140
	Damage (random(12, 12))
	RenderStyle "Add"
	Alpha 0.9
	Scale 0.15
	DamageType "FriendBullet"
	States
	{
	Spawn:
		TRAC A 1 BRIGHT
		Loop
	Death:
	XDeath:
		TNT1 A 1
		Stop
	}
}

// ---------------------------------------------------------------------------
// The bot itself
// ---------------------------------------------------------------------------

Actor Sentrybot : SwitchableDecoration
{
	Scale 0.5
	Health 150
	Radius 10
	Height 24
	Mass 1000
	MaxTargetRange 4000
	Speed 3
	FastSpeed 20
	PainChance 60
	Species "Marines"
	Deathsound "Weapons/Lexplosion"
	MONSTER
	+QUICKTORETALIATE
	+LOOKALLAROUND
	+PUSHABLE
	+SLIDESONWALLS
	+FLOORCLIP
	-FASTER
	+NOBLOOD
	+MTHRUSPECIES
	+THRUSPECIES
	+DONTHURTSPECIES
	+NOBLOCKMONST
	-COUNTKILL
	MaxStepHeight 48
	MaxDropOffHeight 48
	States
	{
	Spawn:
		STRY A 1
		TNT1 A 0 A_GiveInventory("TargetIsAMarine") // stops sentries from firing at each other
		STRY A 1 A_Look
		Loop

	ForgetTarget:
		TNT1 A 0 A_ClearTarget
		Goto See

	Idle:
	See:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 0)
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1)
		TNT1 A 0 A_Recoil(-1)
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot5")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		STRY JJ 1 A_Chase
		TNT1 A 0 A_ChangeFlag("FASTER", 0)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		STRY BB 1 A_Chase
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot6")
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		STRY CC 1 A_Chase
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		STRY DD 1 A_Chase
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot7")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 1)
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		STRY EE 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		STRY FF 1 A_Chase
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot5")
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		STRY GG 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_CheckSight("ForgetTarget")
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		STRY HH 1 A_Chase
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot6")
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		STRY II 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "FollowPlayer")
		Goto See

	FollowPlayer:
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("FASTER", 1)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		TNT1 A 0 A_JumpIfCloser(150, "Waits")
		TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0)
		TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0)
		STRY J 1 A_Chase
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot5")
		TNT1 A 0 A_Recoil(-1)
		STRY JJ 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		STRY BB 1 A_Chase
		TNT1 A 0 A_CheckSight("CheckIfPlayerSee")
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot6")
		TNT1 A 0 A_Recoil(-1)
		STRY CC 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		STRY DD 1 A_Chase
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot7")
		TNT1 A 0 A_Recoil(-1)
		STRY EE 1 A_Chase
		TNT1 A 0 A_Recoil(-1)
		STRY FF 1 A_Chase
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot5")
		TNT1 A 0 A_Recoil(-1)
		STRY GG 1 A_Chase
		Goto CheckIfPlayerSee

	CheckIfPlayerSee:
		TNT1 A 0
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "Pathfind")
		Goto See

	Pathfind:
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		STRY HH 1 A_Chase
		TNT1 A 0 A_JumpIfCloser(200, "Waits")
		Goto FollowPlayer

	Waits:
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1)
		STRY A 0 A_Look
		TNT1 A 0 A_ChangeFlag("FRIENDLY", 0)
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
		STRY A 1 A_LookEx(0, 0, 0, 0, 0, "FollowPlayer")
		TNT1 A 0 A_CheckSight("FollowPlayer")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1)
		TNT1 A 0 A_JumpIfCloser(300, "Waits")
		Goto FollowPlayer

	Missile:
		TNT1 A 0
		TNT1 A 0 A_ChangeFlag("NODROPOFF", 1)
		TNT1 A 0 A_JumpIfInTargetInventory("TargetIsAMarine", 1, "FollowPlayer") // never remove this one
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "Waits")
		TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1)
		TNT1 A 0 A_ChangeFlag("SOLID", 1)
		TNT1 A 0 A_JumpIfCloser(300, "Retreat")
		STRY E 1 A_FaceTarget
		TNT1 A 0 A_JumpIfInTargetInventory("IsPlayer", 1, "Waits")
		TNT1 A 0 A_PlaySound("SentryBotSee", 3)
		STRY AA 6 A_FaceTarget
	ActualFireState:
		STRY N 1 BRIGHT A_CustomMissile("BDSentryTracer", 20, 0, random(-1, 1), CMF_OFFSETPITCH, random(0, 2))
		TNT1 A 0 A_PlaySound("SMG/Fire", 1)
		STRY A 1 A_FaceTarget
		STRY O 1 BRIGHT A_CustomMissile("BDSentryTracer", 20, 0, random(-1, 1), CMF_OFFSETPITCH, random(0, 2))
		TNT1 A 0 A_PlaySound("SMG/Fire", 1)
		STRY A 1 A_FaceTarget
		STRY N 1 BRIGHT A_CustomMissile("BDSentryTracer", 20, 0, random(-1, 1), CMF_OFFSETPITCH, random(0, 2))
		TNT1 A 0 A_PlaySound("SMG/Fire", 1)
		STRY A 1 A_FaceTarget
		STRY O 1 BRIGHT A_CustomMissile("BDSentryTracer", 20, 0, random(-1, 1), CMF_OFFSETPITCH, random(0, 2))
		TNT1 A 0 A_PlaySound("SMG/Fire", 1)
		STRY A 1 A_FaceTarget
		STRY N 1 BRIGHT A_CustomMissile("BDSentryTracer", 20, 0, random(-1, 1), CMF_OFFSETPITCH, random(0, 2))
		TNT1 A 0 A_PlaySound("SMG/Fire", 1)
		STRY A 1 A_FaceTarget
		STRY O 1 BRIGHT A_CustomMissile("BDSentryTracer", 20, 0, random(-1, 1), CMF_OFFSETPITCH, random(0, 2))
		TNT1 A 0 A_PlaySound("SMG/Fire", 1)
		STRY A 1 A_FaceTarget
		Goto See

	Retreat:
		TNT1 A 0
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot5")
		STRY J 2 A_Recoil(2)
		TNT1 A 0 A_FaceTarget
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot6")
		STRY B 2 A_Recoil(2)
		TNT1 A 0 A_FaceTarget
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot7")
		STRY C 2 A_Recoil(3)
		TNT1 A 0 A_FaceTarget
		NULL A 0 A_PlaySoundEx("Monsters/Sentry/Walking", "SoundSlot5")
		STRY D 2 A_Recoil(4)
		TNT1 A 0 A_FaceTarget
		Goto ActualFireState

	Pain:
		STRY A 2
		TNT1 A 0 A_PlaySound("SentryBotPain")
		STRY A 2 A_Pain
		Goto See+1

	Death:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("SentrybotDeath", 3)
		STRY HHHHH 6 A_SpawnItemEx("SentryBotExplode", random(-15, 15), random(-15, 15), random(0, 15))
		STRY I 4 A_NoBlocking
		STRY JKLM 4
		STRY M -1
		Stop
	}
}

Actor SentryBotExplode
{
	+CLIENTSIDEONLY
	Projectile
	+MISSILE
	Scale 0.5
	+THRUACTORS
	+NOGRAVITY
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 0 A_PlaySound("weapons/rocklx")
		MISL B 8 Bright
		MISL C 6 Bright
		MISL D 4 Bright
		Stop
	}
}
